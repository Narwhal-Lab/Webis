# === Webis v2 Configuration Template ===
# Rename this file to .env and fill in the values
# Or run `webis run` and we'll help you set it up!

# ----------------------------------
# LLM Providers (Required)
# ----------------------------------

# Wendalog (DeepSeek Proxy) - Recommended
WENDALOG_API_KEY=

# SiliconFlow (DeepSeek Official)
SILICONFLOW_API_KEY=

# OpenAI (Generic)
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# ----------------------------------
# Data Sources (Recommended)
# ----------------------------------
#travily搜索引擎（https://www.tavily.com/）
TAVILY_API_KEY=
#bocha搜索引擎（https://open.bochaai.com/）
BOCHA_API_KEY=

BRIGHTDATA_API_TOKEN=

#exp_mcp工具（https://exa.ai/）
EXA_API_KEY=
#firecrawl_mcp工具（https://www.firecrawl.dev/）
FIRECRAWL_API_KEY=
#serper搜索引擎（https://serper.dev/）
SERPER_API_KEY=



