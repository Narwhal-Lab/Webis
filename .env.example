# === Webis v2 Configuration Template ===
# Rename this file to .env and fill in the values
# Or run `webis run` and we'll help you set it up!

# ----------------------------------
# LLM Providers (Required)
# ----------------------------------

# Wendalog (DeepSeek Proxy) - Recommended
WENDALOG_API_KEY=

# SiliconFlow (DeepSeek Official)
SILICONFLOW_API_KEY=

# OpenAI (Generic)
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# ----------------------------------
# Data Sources (Recommended)
# ----------------------------------

# Serper.dev (Fast Google Proxy)
# Get key: https://serper.dev
SERPER_API_KEY=

# GNews (News API)
# Get key: https://gnews.io
GNEWS_API_KEY=

# GitHub (For accessing repos)
# Get key: https://github.com/settings/tokens
GITHUB_TOKEN=

TAVILY_API_KEY=

BOCHA_API_KEY=

BRIGHTDATA_API_TOKEN=

