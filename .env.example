# Webis Environment Configuration
# Copy this file to .env and fill in your values

# ========================================
# Core Configuration
# ========================================
WEBIS_ENV=development
WEBIS_PORT=8000
WEBIS_HOST=localhost
SECRET_KEY=your-secret-key-here-change-this-in-production

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ========================================
# Database Configuration
# ========================================
# SQLite (default, good for development)
DATABASE_URL=sqlite:///webis.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/webis

# ========================================
# Redis Configuration (for background tasks)
# ========================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ========================================
# LLM Provider API Keys
# ========================================
# At least one LLM provider is required

# OpenAI (recommended)
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# DeepSeek (alternative)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# SiliconFlow (recommended for China, supports multiple models)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1


# moonshot 
MOONSHOT_API_KEY=

# zhouliu
ZHOULIU_API_KEY=

# greatrouter
GREATROUTER_API_KEY=

# ========================================
# Search/Scraping API Keys
# ========================================
# At least one search API is recommended

# SerpAPI (Google Search)
SERPER_API_KEY=

# Tavily (AI-powered search)
TAVILY_API_KEY=

# Exa (Advanced search)
EXA_API_KEY=

# Firecrawl (Web scraping)
FIRECRAWL_API_KEY=

# Bocha Search
BOCHA_API_KEY=

# Bright Data
BRIGHTDATA_API_TOKEN=

# Baidu Qianfan AI Search (MCP)
BAIDU_AISEARCH_BEARER=
BAIDU_AISEARCH_MCP_URL=https://qianfan.baidubce.com/v2/ai_search/mcp

# Reddit API
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=webis-bot

# ========================================
# Vector Store Configuration
# ========================================
# ChromaDB (default, local)
VECTOR_STORE_PATH=./chroma_db

# Milvus (Phase 2)
MILVUS_URI=http://localhost:19530

# Pinecone (cloud alternative)
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_ENVIRONMENT=us-east-1-aws
# PINECONE_INDEX_NAME=webis

# ========================================
# Neo4j Configuration (optional, for graph features)
# ========================================
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ========================================
# Monitoring and Logging
# ========================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Sentry (error tracking, optional)
# SENTRY_DSN=your-sentry-dsn-here

# Prometheus (metrics, optional)
# PROMETHEUS_ENABLED=true
# PROMETHEUS_PORT=9090

# ========================================
# Feature Flags
# ========================================
# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# Enable caching
ENABLE_CACHE=true
CACHE_TTL=3600

# Enable rate limiting
ENABLE_RATE_LIMITING=true
RATE_LIMIT=100

# ========================================
# Performance Settings
# ========================================
# Maximum concurrent tasks
MAX_CONCURRENT_TASKS=10

# Task timeout (seconds)
TASK_TIMEOUT=300

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY=5

# ========================================
# File Upload Settings
# ========================================
# Maximum file size (MB)
MAX_FILE_SIZE=100

# Allowed file extensions
ALLOWED_FILE_EXTENSIONS=pdf,docx,txt,md,csv,json,html,xml

# ========================================
# Developer Settings
# ========================================
# Enable debug mode
DEBUG=false

# Enable profiling
ENABLE_PROFILING=false

# Test mode (uses mock data)
TEST_MODE=false

# ========================================
# Security Settings
# ========================================
# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Trusted proxies (comma-separated)
TRUSTED_PROXIES=

# Encryption key for sensitive data
ENCRYPTION_KEY=your-encryption-key-here

# ========================================
# Email Notifications (optional)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM="Webis <noreply@webis.dev>"
EMAIL_ENABLED=false

# ========================================
# Third-party Integrations (optional)
# ========================================
# Slack webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# ========================================
# Notes
# ========================================
# 1. Never commit this file to version control
# 2. Keep .env in .gitignore
# 3. Use strong, unique values for production
# 4. Rotate API keys regularly
# 5. Use environment-specific configurations
