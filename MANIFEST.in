include README.md
include LICENSE
include CHANGELOG.md
include AUTHORS
include pyproject.toml

recursive-include src/webis *.py
recursive-include src/webis_visualizer *.py
recursive-include src/webis/assets *.svg *.png *.jpg *.jpeg *.gif
recursive-include docs *.md *.rst
recursive-include examples *.py *.md *.json *.yaml
recursive-include templates *.py *.md *.yaml
recursive-include setup *.sh *.txt

global-exclude __pycache__
global-exclude *.pyc
global-exclude .pytest_cache
global-exclude .DS_Store
global-exclude .git*
global-exclude .idea
global-exclude *.egg-info
global-exclude build
global-exclude dist
global-exclude .mypy_cache
global-exclude .ruff_cache
